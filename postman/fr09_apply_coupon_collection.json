                "type": "text/javascript",
                "exec": [
                  "// Trigger ghi nhận 1 lượt sử dụng cho SAVE10 trước khi test giới hạn",
                  "const baseUrl = pm.environment.get('baseUrl') || 'http://localhost:3000';",
                  "const studentId = pm.environment.get('student_id') || '25127001';",
                  "const useCouponReq = {",
                  "    url: baseUrl + '/api/coupon-usage',",
                  "    method: 'POST',",
                  "    header: {",
                  "        'Content-Type': 'application/json',",
                  "        'Authorization': 'Bearer ' + pm.environment.get('user_token'),",
                  "        'X-Student-Id': studentId",
                  "    },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ coupon_id: 1 }) }",
                  "};",
                  "pm.sendRequest(useCouponReq, function (err, res) {",
                  "    console.log('[SETUP] Recorded usage for coupon 1');",
                  "});"
                ]
