                "type": "text/javascript",
                "exec": [
                  "pm.test('TC_FR09_COND_01: Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('TC_FR09_COND_01: Coupon applied successfully', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.success).to.be.true;",
                  "    pm.expect(data).to.have.property('discount_amount');",
