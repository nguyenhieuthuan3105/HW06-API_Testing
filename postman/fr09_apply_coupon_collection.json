{
  "info": {
    "name": "HW06 - FR-09: Apply Coupon Collection",
    "_postman_id": "fr09-apply-coupon-collection-25127001",
    "description": "Bộ kiểm thử tự động toàn diện 45 Test Cases cho API FR-09: Áp dụng mã giảm giá (POST /api/apply-coupon) thuộc hệ thống EShop SUT với các assertions nghiêm ngặt đối chiếu đặc tả kỹ thuật.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Header Chống Gian Lận (Anti-AI-Cheat) bắt buộc",
          "const studentId = pm.environment.get('student_id') || '25127001';",
          "pm.request.headers.upsert({ key: 'X-Student-Id', value: studentId });",
          "// Tự động gắn Bearer Token nếu request không ghi đè",
          "const userToken = pm.environment.get('user_token');",
          "if (userToken && !pm.request.headers.has('Authorization')) {",
          "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + userToken });",
          "}"
        ]
      }
    }
  ],
