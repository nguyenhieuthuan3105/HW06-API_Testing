          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Lấy ETag trước khi gửi request",
                  "const baseUrl = pm.environment.get('baseUrl') || 'http://localhost:3000';",
                  "pm.sendRequest(baseUrl + '/api/products/1', function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "        const etag = res.headers.get('ETag');",
                  "        if (etag) {",
                  "            pm.environment.set('product_1_etag', etag);",
                  "            console.log('[CACHE] Pre-fetched ETag:', etag);",
                  "        }",
                  "    }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC_FR06_EXT_05: Status code is 304 Not Modified (hoặc 200 nếu cache tắt)', function () {",
                  "    pm.expect([200, 304]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "If-None-Match",
                "value": "{{product_1_etag}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
