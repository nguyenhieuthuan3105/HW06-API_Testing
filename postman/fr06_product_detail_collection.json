        {
          "name": "TC_FR06_ST_07_View_Immediately_After_Creation",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Tự động tạo sản phẩm tạm thời trong Pre-request",
                  "const baseUrl = pm.environment.get('baseUrl') || 'http://localhost:3000';",
                  "const studentId = pm.environment.get('student_id') || '23127125';",
                  "const createReq = {",
                  "    url: baseUrl + '/api/products',",
                  "    method: 'POST',",
                  "    header: {",
                  "        'Content-Type': 'application/json',",
                  "        'X-Student-Id': studentId",
                  "    },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({",
                  "            name: 'SP State Transition Temp',",
                  "            price: 199000,",
                  "            description: 'Temporary product created for state test',",
                  "            imageUrl: 'https://placehold.co/300x300/png',",
                  "            category_id: 1",
                  "        })",
                  "    }",
                  "};",
                  "pm.sendRequest(createReq, function (err, res) {",
                  "    if (!err && (res.code === 200 || res.code === 201)) {",
                  "        const json = res.json();",
                  "        const createdId = json.id || json.data?.id || 1;",
                  "        pm.environment.set('temp_product_id', createdId);",
                  "        console.log('[SETUP] Created Temp Product ID:', createdId);",
                  "    }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC_FR06_ST_07: Status code is 200 OK for newly created product', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "// Post-response: Xóa ngầm sản phẩm tạm thời để chuẩn bị cho ST_08",
                  "const baseUrl = pm.environment.get('baseUrl') || 'http://localhost:3000';",
                  "const tempId = pm.environment.get('temp_product_id');",
                  "if (tempId) {",
                  "    const deleteReq = {",
                  "        url: baseUrl + '/api/products/' + tempId,",
                  "        method: 'DELETE',",
                  "        header: { 'X-Student-Id': pm.environment.get('student_id') || '23127125' }",
                  "    };",
                  "    pm.sendRequest(deleteReq, function (err, res) {",
                  "        console.log('[TEARDOWN] Deleted Temp Product ID:', tempId);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{temp_product_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{temp_product_id}}"
              ]
            }
          }
        },
